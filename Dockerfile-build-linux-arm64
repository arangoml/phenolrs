# Dockerfile-build-linux-arm64

# Use Ubuntu 22.04 for ARM64
FROM --platform=linux/arm64 ubuntu:22.04

# avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:${PATH}"

# install system tools, Python, OpenSSL, Rustup
RUN apt-get update -y && \
    apt-get upgrade -y && \
    apt-get install -y \
      build-essential \
      curl \
      git \
      python3 \
      python3-pip \
      libssl-dev \
      pkg-config && \
    rm -rf /var/lib/apt/lists/*

# install Rust toolchain and the ARM64 target
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y && \
    rustup target add aarch64-unknown-linux-gnu

# upgrade pip and install maturin (with patchelf support)
RUN pip3 install --upgrade pip && \
    pip3 install maturin maturin[patchelf]

# set build workspace inside the container
WORKDIR /io

# use maturin as the entrypoint so the GH Action can just pass `build …`
ENTRYPOINT ["maturin"]
